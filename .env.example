# En el dashboard de Supabase (Project Settings -> API Keys) esta clave puede
# aparecer como "anon public" (sistema antiguo) o como "Publishable key"
# (sistema nuevo, suele empezar con sb_publishable_...). Ambas cumplen el
# mismo rol para este proyecto: úsala tal cual en VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
